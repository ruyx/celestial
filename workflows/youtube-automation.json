{
  "name": "YouTube Video Production - Automated",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "daily-trigger",
      "name": "Daily Trigger (12:00 PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { execSync } = require('child_process');\n\ntry {\n  const output = execSync('cd /home/suario/ruy-projects/project-yt && node production-pipeline.js produce', { encoding: 'utf-8' });\n  return { success: true, output };\n} catch (error) {\n  return { success: false, error: error.message };\n}"
      },
      "id": "run-production",
      "name": "Run Production Pipeline",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.success }}",
              "value2": "true"
            }
          ]
        }
      },
      "id": "check-success",
      "name": "Production Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "Video produced successfully"
            }
          ]
        }
      },
      "id": "success-log",
      "name": "Log Success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [850, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "Production failed"
            }
          ]
        }
      },
      "id": "error-log",
      "name": "Log Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [850, 400]
    },
    {
      "parameters": {
        "amount": 24,
        "unit": "hours"
      },
      "id": "wait-analytics",
      "name": "Wait 24h for Analytics",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { execSync } = require('child_process');\n\ntry {\n  const output = execSync('cd /home/suario/ruy-projects/project-yt && node agents/analytics-monitor.js', { encoding: 'utf-8' });\n  return { success: true, output };\n} catch (error) {\n  return { success: false, error: error.message };\n}"
      },
      "id": "collect-analytics",
      "name": "Collect Analytics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 200]
    }
  ],
  "connections": {
    "Daily Trigger (12:00 PM)": {
      "main": [[{ "node": "Run Production Pipeline", "type": "main", "index": 0 }]]
    },
    "Run Production Pipeline": {
      "main": [[{ "node": "Production Success?", "type": "main", "index": 0 }]]
    },
    "Production Success?": {
      "main": [
        [{ "node": "Log Success", "type": "main", "index": 0 }],
        [{ "node": "Log Error", "type": "main", "index": 0 }]
      ]
    },
    "Log Success": {
      "main": [[{ "node": "Wait 24h for Analytics", "type": "main", "index": 0 }]]
    },
    "Wait 24h for Analytics": {
      "main": [[{ "node": "Collect Analytics", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
