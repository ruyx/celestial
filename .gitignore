output/
data/processed-verses.json
data/videos/
data/thumbnails/
data/audio/
audio-narration-*.mp3
*.mp4
*.mp3

# Archivos temporales
tmp/
temp/
*.tmp

# FFmpeg static (no necesario en repo)
ffmpeg-*/

# Coverage y tests
coverage/
.nyc_output/
test/
__tests__/

# Archivos de configuración local
.agents/
skills-lock.json

# Archivos de documentación temporal
PIPELINE_SUMMARY_*.md
COPY_PASTE_READY.txt
outh sp vr/

