.env
.env.local
.env.*.local
youtube-token.json
youtube-token.b64
youtube-credentials.json
client_secret*.json
refresh-youtube-token.js

# Node.js
node_modules/
npm-debug.log
yarn-error.log
package-lock.json

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini
*.Zone.Identifier

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

