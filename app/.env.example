# ============================================
# Retea Project - Environment Variables
# ============================================
#
# IMPORTANTE: Este archivo es una plantilla.
# Copiar a .env.local y reemplazar con valores reales.
#
# NUNCA subir .env.local a Git (está en .gitignore)
# ============================================

# ============================================
# SUPABASE CONFIGURATION (Project: Retea)
# ============================================
# Project URL: https://boffacmghclyirjcopzq.supabase.co
# Project Ref: boffacmghclyirjcopzq
# Region: us-east-1
#
# IMPORTANTE: Estas credenciales son SOLO para el proyecto Retea.
# NO son globales. Otros proyectos usan sus propias credenciales.
# ============================================

# Public API Key (anon key) - Safe para cliente
# Exponer en frontend, tiene RLS protection
PUBLIC_SUPABASE_URL=https://boffacmghclyirjcopzq.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Service Role Key (admin) - NUNCA exponer en cliente
# Solo para server-side operations (backend, migrations, scripts)
# MANTENER EN SECRETO - Bypass RLS
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# Database Direct Connection
# Para migraciones y scripts SQL directos
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD_HERE
SUPABASE_DB_HOST=db.boffacmghclyirjcopzq.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres

# Connection String (PostgreSQL)
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD_HERE@db.boffacmghclyirjcopzq.supabase.co:5432/postgres

# ============================================
# VERCEL CONFIGURATION (Deployment)
# ============================================

# Vercel Project ID (obtener después de link)
VERCEL_PROJECT_ID=

# Vercel Org ID (obtener después de link)
VERCEL_ORG_ID=

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Environment
NODE_ENV=development

# App URL (local development)
PUBLIC_APP_URL=http://localhost:5173

# App URL (production - después de deploy)
# PUBLIC_APP_URL=https://retea.vercel.app

# ============================================
# FEATURE FLAGS (Opcional)
# ============================================

# Enable/disable features
PUBLIC_ENABLE_ANALYTICS=false
PUBLIC_ENABLE_ERROR_TRACKING=false

# ============================================
# NOTAS DE SEGURIDAD
# ============================================
#
# 1. PUBLIC_* variables → Expuestas en cliente (bundle JavaScript)
#    - Solo incluir datos públicos
#    - NUNCA incluir secrets, passwords, API keys privadas
#
# 2. Variables SIN PUBLIC_ → Solo disponibles en server-side
#    - Seguras para secrets
#    - No expuestas en bundle
#
# 3. SUPABASE_SERVICE_ROLE_KEY:
#    - Bypass Row Level Security (RLS)
#    - Solo para backend trusted
#    - NUNCA en cliente
#
# 4. Vercel deployment:
#    - Variables PUBLIC_* se configuran en Vercel Dashboard
#    - Variables privadas también en Vercel (encrypted)
#
# 5. Supabase CLI:
#    - Usa estas credenciales para link local
#    - No afecta otros proyectos
#
# ============================================
